<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ 通知：每日总结/提醒必需（运行时申请） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 每日小结镜像到系统日历（运行时申请） -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- 定时提醒：精确闹钟（Android 12+ 需用户到系统设置开启，未开时自动用 setWindow 兜底） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 开机重排提醒 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 识屏：前台服务（MediaProjection 在 API 34+ 必须在 FGS 中使用） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- 识屏悬浮小窗：显示在其他应用上层（运行时检查 + 引导开启） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 悬浮球前台服务（API 34+ 的 specialUse 类型需要） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name=".AssistantApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Assistant">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Assistant"
            android:screenOrientation="fullSensor"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 分享文本到助手 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- 分享图片到助手（视觉模型分析） -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- 识屏截屏前台服务（API 34+ 必须声明 mediaProjection 类型） -->
        <service
            android:name=".service.ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- 快捷设置磁贴「识屏」 -->
        <service
            android:name=".tiles.ScreenSenseTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/tile_screen_sense"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- 悬浮球前台服务（specialUse：常驻显示悬浮球与响应点击） -->
        <service
            android:name=".service.FloatingBallService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="悬浮球常驻悬浮窗，点击展开浮动界面" />
        </service>

        <!-- 浮动界面（悬浮球展开的玻璃拟态面板）：
             独立 task + 排除最近任务，finish 后系统自动回原 App -->
        <activity
            android:name=".feature.floating.FloatingPanelActivity"
            android:exported="false"
            android:theme="@style/Theme.Assistant.Translucent"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:screenOrientation="fullSensor"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />

        <!-- 识屏授权中转（透明无 UI）：悬浮球场景下弹系统授权，避免闪现 App 界面 -->
        <activity
            android:name=".service.MediaProjectionPermissionActivity"
            android:exported="false"
            android:theme="@style/Theme.Assistant.Translucent"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:screenOrientation="fullSensor"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 提醒到点广播 -->
        <receiver
            android:name=".receiver.ReminderReceiver"
            android:exported="false" />

        <!-- 开机后重排提醒 -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
