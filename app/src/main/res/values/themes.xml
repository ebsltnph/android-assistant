<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose 全权接管界面，XML 主题只需无 ActionBar；背景用深墨夜景色（避免启动闪白） -->
    <style name="Theme.Assistant" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#0B1322</item>
    </style>

    <!-- 浮动界面（悬浮球展开面板）用：透明窗口，让下层 App 可见，
         变暗/光晕/面板全部由 Compose 内容绘制 -->
    <style name="Theme.Assistant.Translucent" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
